<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>XeneonTouchDriver</string>

    <key>CFBundlePackageType</key>
    <string>DEXT</string>

    <key>CFBundleShortVersionString</key>
    <string>2.1</string>

    <key>CFBundleVersion</key>
    <string>18</string>

    <key>IOKitPersonalities</key>
    <dict>

        <key>XeneonEdgeTouchUSB</key>
        <dict>
            <key>CFBundleIdentifier</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

            <!--
                For HID dexts the kernel-side IOClass must be AppleUserHIDDevice
                (IOHIDFamily's kernel half of the HID device stack) — mirroring
                Apple's own AppleUserUSBHostHIDDevice personalities in
                com.apple.AppleUserHIDDrivers.dext. CFBundleIdentifierKernel
                names the kext providing the IOClass (IOHIDFamily), NOT the
                provider's family. With generic IOUserService here,
                IOUserUSBHostHIDDevice::Start fails with kIOReturnUnsupported.
            -->
            <key>CFBundleIdentifierKernel</key>
            <string>com.apple.iokit.IOHIDFamily</string>

            <key>IOClass</key>
            <string>AppleUserHIDDevice</string>

            <key>IOUserClass</key>
            <string>XeneonTouchDriver</string>

            <key>IOUserServerName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

            <key>IOProviderClass</key>
            <string>IOUSBHostInterface</string>

            <!-- All four keys required for IOUSBHostInterface matching -->
            <key>idVendor</key>
            <integer>10176</integer>

            <key>idProduct</key>
            <integer>2137</integer>

            <!-- Configuration 1 is standard for this device -->
            <key>bConfigurationValue</key>
            <integer>1</integer>

            <!-- Interface 0 = WCH touch digitizer -->
            <key>bInterfaceNumber</key>
            <integer>0</integer>

            <key>IOProbeScore</key>
            <integer>100000</integer>

            <!--
                Disable interrupt-pipe idling (USB suspend). Mirrors Apple's
                own AppleUSBKeyboard personality. macOS idles HID pipes far
                more aggressively than Windows; cheap touch firmware often
                mishandles suspend — symptoms match ours exactly: control
                transfers fine, no interrupt stream, periodic self-resets.
            -->
            <key>kUSBHIDDeviceIdlePolicy</key>
            <integer>0</integer>

        </dict>

    </dict>

    <key>OSBundleUsageDescription</key>
    <string>XeneonTouchDriver enables multitouch support for the Corsair Xeneon Edge touchscreen on macOS.</string>

</dict>
</plist>
